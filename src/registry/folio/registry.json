{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "base",
      "type": "registry:base",
      "title": "Folio Base",
      "description": "Installs the shadcn/ui (b0 preset) primitives that Folio extensions compose with.",
      "config": {
        "style": "base-nova",
        "tailwind": {
          "baseColor": "neutral"
        },
        "iconLibrary": "lucide",
        "rtl": false,
        "menuColor": "default",
        "menuAccent": "subtle"
      },
      "dependencies": [
        "@base-ui/react",
        "class-variance-authority",
        "cn",
        "lucide-react"
      ],
      "registryDependencies": [
        "font-inter",
        "button",
        "card",
        "input",
        "label"
      ]
    },
    {
      "name": "editor-extension",
      "type": "registry:lib",
      "title": "Editor Extension",
      "description": "Internal helper for declaring Tiptap extensions as editor components.",
      "dependencies": [
        "@tiptap/core@3.32.2"
      ],
      "categories": [
        "editor",
        "internal"
      ],
      "files": [
        {
          "path": "lib/editor-extension.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "editor",
      "type": "registry:ui",
      "title": "Editor",
      "description": "A composable rich text editor built on Tiptap, with a toolbar, bubble menu, character count and typeset content.",
