{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "base",
      "type": "registry:base",
      "title": "Folio Base",
      "description": "Installs the shadcn/ui (b0 preset) primitives that Folio extensions compose with.",
      "config": {
        "style": "base-nova",
        "tailwind": {
          "baseColor": "neutral"
        },
        "iconLibrary": "lucide",
        "rtl": false,
        "menuColor": "default",
        "menuAccent": "subtle"
      },
      "dependencies": [
        "@base-ui/react",
        "class-variance-authority",
        "cn",
        "lucide-react"
      ],
      "registryDependencies": [
        "font-inter",
        "button",
        "card",
        "input",
        "label"
      ]
    },
    {
      "name": "login-01",
      "type": "registry:block",
      "title": "Login 01",
      "description": "A login form composed from shadcn/ui primitives.",
      "dependencies": ["cn"],
      "registryDependencies": ["button", "card", "input", "label"],
      "categories": ["authentication", "login"],
      "files": [
        {
          "path": "blocks/login-01/components/login-form.tsx",
          "type": "registry:component"
        }
      ]
    }
  ]
}
