        "@tiptap/react@3.32.2",
        "cn",
        "lucide-react"
      ],
      "registryDependencies": [
        "litingyes/folio/editor-extension",
        "litingyes/folio/editor-text",
        "litingyes/folio/editor-paragraph",
        "litingyes/folio/editor-hard-break",
        "button",
        "kbd",
        "separator",
        "toggle",
        "tooltip"
      ],
      "categories": [
        "editor"
      ],
      "files": [
