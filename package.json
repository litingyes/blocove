{
  "name": "folio",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "predev": "pnpm run registry:prepare",
    "build": "vite build",
    "prebuild": "pnpm run registry:prepare",
    "preview": "vite preview",
    "generate-routes": "tsr generate",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "pretypecheck": "pnpm run registry:prepare",
    "typecheck": "tsc --noEmit",
    "registry:build": "shadcn build",
    "catalog:build": "node scripts/build-catalog.mjs",
    "registry:prepare": "pnpm run registry:build && pnpm run catalog:build",
    "registry:validate": "shadcn registry validate litingyes/folio",
    "prepare": "lefthook install",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.167.45",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.0",
    "typescript": "^6.0.2",
    "vite": "^8"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,json,jsonc,yaml,yml,md,css,html}": "eslint --fix --no-warn-ignored"
  }
}
