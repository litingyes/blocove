{
  "name": "blocove",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "predev": "pnpm run registry:prepare",
    "build": "vite build",
    "prebuild": "pnpm run registry:prepare",
    "preview": "vite preview",
    "generate-routes": "tsr generate",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "pretypecheck": "pnpm run registry:prepare",
    "typecheck": "tsc --noEmit",
    "registry:build": "node scripts/clean-registry.mjs && shadcn build",
    "catalog:build": "node scripts/build-catalog.mjs",
    "registry:prepare": "pnpm run registry:build && pnpm run catalog:build",
    "registry:validate": "shadcn registry validate litingyes/blocove",
    "preset:check": "node scripts/check-preset.mjs",
    "prepare": "lefthook install",
    "check": "pnpm run preset:check && pnpm run typecheck && pnpm run lint && pnpm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/commands": "^6.11.1",
