    "@tanstack/router-cli": "^1.167.45",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.0",
    "typescript": "^6.0.2",
    "vite": "^8"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,json,jsonc,yaml,yml,md,css,html}": "eslint --fix --no-warn-ignored"
  }
