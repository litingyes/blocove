{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",

    /* Bundler mode */
    "moduleResolution": "bundler",
    "paths": {
      "@/components/ui/rich-text-editor/editor": [
        "./src/registry/blocove/ui/rich-text-editor/editor.tsx"
      ],
      "@/lib/rich-text-editor-extension": [
        "./src/registry/blocove/lib/rich-text-editor-extension.ts"
      ],
      "@/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,

    /* Linting */
    "skipLibCheck": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "eslint.config.js",
    "vite.config.ts"
  ]
}
